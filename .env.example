# Copy this file to .env and fill in your values.
# .env is gitignored and should never be committed.

# --- Local settings ---
ACCELERATOR=cpu   # set to "gpu" for local GPU runs

# --- Cluster connection (used by 03_migrate_to_cluster.sh) ---
LRZ_USER=your-lrz-username
LRZ_HOST=login.ai.lrz.de
LRZ_SCRATCH=/dss/mcmlscratch/XX/your-lrz-username

# --- PhysioNet Credentials (01_download_pcxr.sh) ---
PHYSIO_USERNAME=your_username
PHYSIO_PASSWORD=your_password

