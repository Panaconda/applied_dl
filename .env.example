# Copy this file to .env and fill in your values.
# .env is gitignored and should never be committed.

# --- Local settings ---
ACCELERATOR=cpu   # set to "gpu" for local GPU runs

# --- Cluster connection (used by 03_migrate_to_cluster.sh) ---
LRZ_USER=your-lrz-username
LRZ_HOST=login.ai.lrz.de
LRZ_SCRATCH=/dss/mcmlscratch/XX/your-lrz-username

# --- Data and model checkpoint directories on the cluster ---
# Only uncomment these if you need to override the default paths.

# If left commented, defaults to: $MCMLSCRATCH/data
# DATA_DIR=/path/to/your/custom/data

# If left commented, defaults to: $MCMLSCRATCH/checkpoints
# CKPT_DIR=/path/to/your/custom/checkpoints

# --- PhysioNet Credentials (01_download_pcxr.sh) ---
PHYSIO_USERNAME=your_username
PHYSIO_PASSWORD=your_password

